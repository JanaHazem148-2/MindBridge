# MindBridge — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# 1. Add your Groq API key (already set below)
# 2. Run:  uvicorn api:app --host 0.0.0.0 --port 8000 --reload
# ─────────────────────────────────────────────────────────────────────────────

# Required: Groq API key — https://console.groq.com/keys
GROQ_API_KEY=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

# Model (best quality)
GROQ_MODEL=llama-3.3-70b-versatile

# API base
GROQ_API_BASE=https://api.groq.com/openai/v1

# ── Authentication ────────────────────────────────────────────────────────────
# JWT secret — change this to a strong random string in production!
JWT_SECRET=mindbridge-change-me-in-production-32chars!!

# Clinician registration secret — admins use this to create clinician accounts
CLINICIAN_ADMIN_SECRET=mindbridge-clinician-secret

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default) — no extra setup needed
DATABASE_URL=sqlite:///./mindbridge_api.db

# Optional PostgreSQL — uncomment and set if you want production-grade storage
# DATABASE_URL=postgresql://user:password@localhost:5432/mindbridge

# Optional Redis cache — uncomment to enable hot-cache for sessions
# REDIS_URL=redis://localhost:6379/0

# ── Region & Language ─────────────────────────────────────────────────────────
MINDBRIDGE_REGION=EG
MINDBRIDGE_ARABIC=1

# ── Generation settings ───────────────────────────────────────────────────────
MINDBRIDGE_MAX_TOKENS=1024
MINDBRIDGE_TEMPERATURE=0.7
MINDBRIDGE_TOP_P=0.9

# ── Paths ─────────────────────────────────────────────────────────────────────
MINDBRIDGE_MEMORY_DIR=./data

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000

# ── Crisis webhooks (optional) ────────────────────────────────────────────────
# CRISIS_WEBHOOK_URL=https://your-webhook.com/crisis
# SMS_WEBHOOK_URL=
# PUSH_WEBHOOK_URL=
